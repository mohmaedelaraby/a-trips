# Overrides for `docker compose`. Copy to .env — every value below is already
# the built-in default, so the stack runs with no .env file at all.

# --- database ---------------------------------------------------------------
POSTGRES_USER=atrip
POSTGRES_PASSWORD=atrip
POSTGRES_DB=atrip
# Host port only; inside the compose network Postgres is always on 5432.
POSTGRES_PORT=5439

# --- api --------------------------------------------------------------------
API_PORT=4000
# Generate a real one for anything public:  openssl rand -base64 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
# Marks the admin/session cookies Secure (HTTPS-only). Keep false for this
# localhost-over-http stack; set to true once the API is served over HTTPS,
# or the browser will silently refuse to store the login cookie.
COOKIE_SECURE=false

# --- object storage (MinIO) -------------------------------------------------
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=atrip-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# MinIO ignores the region; real S3 rejects a mismatch. Set it when you point
# the stack at AWS instead of the bundled MinIO.
S3_REGION=us-east-1
# Host-visible base URL written into image URLs — the browser loads photos from
# here, so it must not be the internal `http://minio:9000`.
S3_PUBLIC_URL=http://localhost:9000


PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Must match the currency prices are quoted in.
PAYPAL_CURRENCY=USD

PRICING_TAX_RATE=0.1
 the chat widget hides itself instead of failing when a guest clicks it.
LLM_API_KEY=
LLM_BASE_URL="LLM_API_KEY"  # Groq's default base URL is the same as the key, so this is a no-op
LLM_MODEL="LLM_MODEL"

# --- web --------------------------------------------------------------------
WEB_PORT=3000
# Read by the browser, so it must be reachable from the host. Baked into the
# client bundle at image build time — changing it needs `--build` to take.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
