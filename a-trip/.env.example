# Overrides for `docker compose`. Copy to .env — every value below is already
# the built-in default, so the stack runs with no .env file at all.

# --- database ---------------------------------------------------------------
POSTGRES_USER=atrip
POSTGRES_PASSWORD=atrip
POSTGRES_DB=atrip
# Host port only; inside the compose network Postgres is always on 5432.
POSTGRES_PORT=5439

# --- api --------------------------------------------------------------------
API_PORT=4000
# Generate a real one for anything public:  openssl rand -base64 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# --- object storage (MinIO) -------------------------------------------------
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=atrip-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# MinIO ignores the region; real S3 rejects a mismatch. Set it when you point
# the stack at AWS instead of the bundled MinIO.
S3_REGION=us-east-1
# Host-visible base URL written into image URLs — the browser loads photos from
# here, so it must not be the internal `http://minio:9000`.
S3_PUBLIC_URL=http://localhost:9000

# --- payments (PayPal) ------------------------------------------------------
# Sandbox credentials from
# https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to run without payments: the API still boots, and the checkout
# shows "payments are not configured" rather than failing when the guest clicks.
# The secret stays server-side; only the client id reaches the browser.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Must match the currency prices are quoted in.
PAYPAL_CURRENCY=USD

# --- pricing ----------------------------------------------------------------
# Tax rate applied to room prices. Quoted prices are tax-INCLUSIVE: the total is
# what the guest pays and this rate shows how much of it is tax. Changing it
# changes the displayed split, not the amount charged.
PRICING_TAX_RATE=0.1

# --- web --------------------------------------------------------------------
WEB_PORT=3000
# Read by the browser, so it must be reachable from the host. Baked into the
# client bundle at image build time — changing it needs `--build` to take.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
