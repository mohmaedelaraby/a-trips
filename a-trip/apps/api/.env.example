DATABASE_URL="postgresql://atrip:atrip@localhost:5439/atrip?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Marks the admin/session cookies Secure (HTTPS-only). Leave false for local
# http://localhost dev, or the browser will silently refuse to store the
# login cookie. Set to true once this runs behind HTTPS.
COOKIE_SECURE=false

# --- payments (PayPal) ------------------------------------------------------
# Sandbox credentials from https://developer.paypal.com/dashboard/applications/sandbox
# Without these the API still boots; /api/payments/config reports configured:false
# and the checkout shows payments as unavailable.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# sandbox (default) or live
PAYPAL_ENV="sandbox"
PAYPAL_CURRENCY="USD"

# --- pricing ----------------------------------------------------------------
# Tax rate applied to room prices. Quoted prices are tax-INCLUSIVE: the total is
# what the guest pays and this rate is used to show how much of it is tax.
# Changing it changes the displayed split, not the amount charged.
PRICING_TAX_RATE=0.1

# --- chat assistant (Groq by default) ---------------------------------------
# The key is the only required line — the two below already match the defaults
# in code. Free key, no card: https://console.groq.com/keys
# Blank key = no assistant: the API boots and the widget hides itself.
LLM_API_KEY=""
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="qwen/qwen3.8-27b"
# If a model 404s, Groq has rotated it — list yours with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"
# Skip the reasoning models (openai/gpt-oss-*): they return empty content and
# put the answer in a `reasoning` field, which reads here as no reply.
#
# Another OpenAI-compatible provider is just these two variables:
#   OpenAI      LLM_BASE_URL="https://api.openai.com/v1"    LLM_MODEL="gpt-4o-mini"
#   OpenRouter  LLM_BASE_URL="https://openrouter.ai/api/v1" LLM_MODEL="<model ending in :free>"
#   Ollama      LLM_BASE_URL="http://localhost:11434/v1"    LLM_MODEL="llama3.1"
