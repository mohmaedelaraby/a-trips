generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  phone        String?
  dateOfBirth  DateTime?
  role         Role       @default(USER)
  adminRole    AdminRole?
  status       UserStatus @default(ACTIVE)
  invitedAt    DateTime?
  lastActiveAt DateTime?
  bookings     Booking[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum Role {
  USER
  ADMIN
}

/// Granular staff permissions; only meaningful when role is ADMIN.
enum AdminRole {
  SUPER_ADMIN
  RESERVATIONS
  CONTENT_EDITOR
}

enum UserStatus {
  ACTIVE
  BANNED
  INVITED
  DISABLED
}

/// Catalogue of amenities offered in the hotel editor's picker.
model Amenity {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Site navigation, editable from the admin portal — the header bar and both
/// footer link columns.
///
/// `value` is what a visitor reads, `href` is where the click goes. An empty
/// href means the destination is not built yet, and the site routes it to
/// /coming-soon instead of rendering a dead label.
model NavLink {
  id        String          @id @default(uuid())
  group     NavLinkGroup
  value     String
  /// Absolute URL, or a site-relative path starting with "/". Null = coming soon.
  href      String?
  /// Absolute hrefs open in a new tab unless this is explicitly turned off.
  openInNewTab Boolean      @default(false)
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([group, sortOrder])
}

/// Where a link appears: the header bar, or one of the two footer columns.
enum NavLinkGroup {
  HEADER
  FOOTER_COMPANY
  FOOTER_SUPPORT
}

model Hotel {
  id          String       @id @default(uuid())
  /// Editable from the portal. Changing it does not break existing links —
  /// the old value moves into previousSlugs and still resolves.
  slug        String       @unique
  /// Slugs this hotel used to answer to, kept so shared links and search
  /// engine results survive a rename.
  previousSlugs String[]   @default([])
  name        String
  city        String
  address     String
  country     String
  description String?
  stars       Int
  latitude    Float?
  longitude   Float?
  amenities   String[]
  status      HotelStatus  @default(DRAFT)
  images      HotelImage[]
  roomTypes   RoomType[]
  bookings    Booking[]
  /// Id of the staff member who created the hotel.
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([city])
  @@index([status])
}

enum HotelStatus {
  DRAFT
  PUBLISHED
  /// Retired but retained: hidden from the site, kept because bookings
  /// reference it. Deleting such a hotel would orphan real reservations.
  ARCHIVED
}

/// Editable site copy that is not a hotel — contact details, social links,
/// the home page hero, the currency label. One row per setting so a new piece
/// of copy needs no migration.
model SiteSetting {
  /// Stable identifier the site reads, e.g. "contact.email".
  key       String   @id
  value     String
  /// Groups settings in the admin UI; carries no meaning to the site.
  group     String   @default("general")
  /// Shown beside the field in the portal so staff know what they are editing.
  label     String
  updatedAt DateTime @updatedAt

  @@index([group])
}

model HotelImage {
  id        String  @id @default(uuid())
  hotelId   String
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([hotelId])
}

model RoomType {
  id               String             @id @default(uuid())
  hotelId          String
  hotel            Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  capacityAdults   Int
  capacityChildren Int                @default(0)
  numOfBeds        Int
  /// Physical rooms of this type; the ceiling for per-date availability.
  totalUnits       Int                @default(1)
  sizeSqm          Float?
  basePrice        Decimal            @db.Decimal(10, 2)
  status           RoomTypeStatus     @default(ACTIVE)
  availability     RoomAvailability[]
  bookings         Booking[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([hotelId])
}

enum RoomTypeStatus {
  ACTIVE
  INACTIVE
}

model RoomAvailability {
  id            String   @id @default(uuid())
  roomTypeId    String
  roomType      RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  totalUnits    Int
  priceOverride Decimal? @db.Decimal(10, 2)
  stopSell      Boolean  @default(false)

  // @@unique already creates a btree on exactly (roomTypeId, date), which every
  // availability read uses. A separate @@index on the same columns was a second,
  // identical btree — 93 MB of the 347 MB table at 862k rows, with zero scans,
  // and maintained on every write. Do not re-add it.
  @@unique([roomTypeId, date])
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  hotelId          String
  hotel            Hotel         @relation(fields: [hotelId], references: [id])
  roomTypeId       String
  roomType         RoomType      @relation(fields: [roomTypeId], references: [id])
  checkInDate      DateTime      @db.Date
  checkOutDate     DateTime      @db.Date
  numAdults        Int
  numChildren      Int           @default(0)
  totalPrice       Decimal       @db.Decimal(10, 2)
  status           BookingStatus @default(PENDING_PAYMENT)
  /// While PENDING_PAYMENT, the instant this booking stops holding inventory.
  /// Availability counts a PENDING_PAYMENT booking only while this is in the
  /// future, so an abandoned checkout releases its room with no sweep required.
  holdExpiresAt    DateTime?
  payment          Payment?
  adminNote        String?
  specialRequests  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([hotelId])
  @@index([status])
  @@index([roomTypeId, checkInDate, checkOutDate])
  @@index([status, holdExpiresAt])
}

enum BookingStatus {
  /// Inventory is held, awaiting payment. Expires at holdExpiresAt.
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  CANCELLED
  /// The payment hold lapsed before the guest paid.
  EXPIRED
}

/// One payment attempt per booking. Kept separate from Booking so the gateway's
/// identifiers and raw payloads never mix into the reservation record.
model Payment {
  id        String        @id @default(uuid())
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider  String        @default("PAYPAL")
  /// Gateway order id, unique so a replayed capture cannot create a second row.
  providerOrderId   String?       @unique
  providerCaptureId String?
  amount    Decimal       @db.Decimal(10, 2)
  currency  String        @default("USD")
  status    PaymentStatus @default(PENDING)
  /// Trimmed gateway response, for support and reconciliation.
  rawResponse Json?
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Locales the site is published in. `EN` is the fallback: a key with no row
/// for the requested locale falls back to English, and then to the shipped
/// JSON default in the web app, so a missing translation degrades to readable
/// text rather than to a raw key on screen.
enum Locale {
  EN
  AR
}

/// Admin-editable text, one row per key per locale.
///
/// Layered under the JSON message files that ship with the web app: those are
/// the defaults, these override them. That means a translator can fix wording
/// in production without a deploy, while the repo still carries a complete,
/// reviewable set of strings.
///
/// Key conventions, so the admin screen can group them:
///   ui.*            static interface strings, mirrored from the JSON files
///   nav.<id>        a navigation link's label
///   setting.<key>   a site setting's value
///   hotel.<id>.*    a hotel's name, description, city or address
model Translation {
  key       String
  locale    Locale
  value     String
  updatedAt DateTime @updatedAt

  @@id([key, locale])
  @@index([locale])
  @@index([key])
}
